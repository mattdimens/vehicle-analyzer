# Copy to .env.local and fill in. Set the same variables in Vercel (Production + Preview).

# Supabase project (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API key (server-only)
GEMINI_API_KEY=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). GA is not loaded when empty.
NEXT_PUBLIC_GA_ID=

# Amazon Associates tag used by /go. Defaults to visualfitme0b-20 when empty.
AMAZON_ASSOCIATE_TAG=

# Amazon Creators API credential (Associates Central > Tools > Creators API). Server-only.
AMAZON_CREATORS_CREDENTIAL_ID=
AMAZON_CREATORS_CREDENTIAL_SECRET=
# The version shown next to the credential, 3.1 or 2.1. Defaults to 3.1 when empty.
AMAZON_CREATORS_CREDENTIAL_VERSION=

# Shared secret for Vercel Cron (vercel.json). Vercel sends it as a Bearer token to
# /api/cron/amazon-items, which refuses requests without it. Any long random string.
# Server-only.
CRON_SECRET=
